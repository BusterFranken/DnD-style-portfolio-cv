# LLM API key (required for CV-to-character-sheet generation).
# Despite the name, this holds the key for WHICHEVER provider LLM_BASE_URL
# points at (OpenAI key by default; a Mistral key when using La Plateforme).
OPENAI_API_KEY=sk-...

# Optional: OpenAI-compatible endpoint override. Leave unset for OpenAI.
# Mistral La Plateforme: https://api.mistral.ai/v1
# LLM_BASE_URL=https://api.mistral.ai/v1

# Optional: model id at that endpoint. Default: gpt-4o-mini
# LLM_MODEL=mistral-medium-latest

# ── Database ────────────────────────────────────────────────────────────
# Storage of generated sheets. Two backends, auto-selected:
#   • Neon Postgres (production/Vercel) — used automatically when a Postgres
#     connection string is present. Vercel's Neon marketplace integration
#     injects DATABASE_URL / POSTGRES_URL for you; nothing to paste by hand.
#   • sql.js SQLite (local dev) — used when no connection string is set.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Force the local SQLite store even if a Postgres URL is present (local testing).
DB_MODE=sqlite

# Optional: base URL for share links (defaults to request origin)
# NEXT_PUBLIC_BASE_URL=https://yourdomain.com
