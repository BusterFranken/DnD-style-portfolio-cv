# OpenAI API key (required for CV-to-character-sheet generation)
OPENAI_API_KEY=sk-...

# Database mode: "sqlite" for local dev, "dynamodb" for AWS production
# Default: sqlite
DB_MODE=sqlite

# DynamoDB table name (only needed when DB_MODE=dynamodb)
DYNAMODB_TABLE=dnd-cv-sheets

# AWS region (only needed for DynamoDB)
AWS_REGION=eu-west-1

# Optional: base URL for share links (defaults to request origin)
# NEXT_PUBLIC_BASE_URL=https://yourdomain.com
